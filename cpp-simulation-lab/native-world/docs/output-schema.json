{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aether World native output contract",
  "description": "Y-up native C++17 scene and sampled 120 Hz simulation. Geometry vertices are local XYZ triples. Mesh triangle/index relationships and physical invariants are enforced by native validation, beyond structural JSON Schema.",
  "type": "object",
  "properties": {
    "project": {
      "const": "aether"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "mode": {
      "const": "native"
    },
    "spec": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "platforms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "bridges": {
          "type": "boolean"
        },
        "water": {
          "type": "boolean"
        },
        "bodies": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "gravity": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 20
        },
        "wind": {
          "type": "number",
          "minimum": -5,
          "maximum": 5
        }
      },
      "required": [
        "prompt",
        "platforms",
        "bridges",
        "water",
        "bodies",
        "gravity",
        "wind"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "dt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "geometry_count": {
          "type": "integer",
          "minimum": 0
        },
        "body_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "initial_water_total": {
          "type": "number",
          "minimum": 0
        },
        "water_total": {
          "type": "number",
          "minimum": 0
        },
        "volume_error": {
          "type": "number",
          "minimum": 0
        },
        "max_penetration": {
          "type": "number",
          "minimum": 0
        },
        "validation": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "checks": {
              "type": "integer",
              "minimum": 0
            },
            "repair_budget": {
              "const": 32
            },
            "violations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "repairs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 32
            }
          },
          "required": [
            "ok",
            "checks",
            "repair_budget",
            "violations",
            "repairs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "steps",
        "dt",
        "geometry_count",
        "body_count",
        "initial_water_total",
        "water_total",
        "volume_error",
        "max_penetration",
        "validation"
      ],
      "additionalProperties": false
    },
    "geometry": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "floor",
              "island",
              "rock",
              "platform",
              "bridge",
              "grass",
              "reservoir",
              "pedestal",
              "pipe"
            ]
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "size": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "solid": {
            "type": "boolean"
          },
          "vertices": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "required": [
          "id",
          "kind",
          "color",
          "position",
          "size",
          "solid",
          "vertices",
          "indices"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "time": {
            "type": "number",
            "minimum": 0
          },
          "contacts": {
            "type": "integer",
            "minimum": 0
          },
          "max_penetration": {
            "type": "number",
            "minimum": 0
          },
          "puzzle_solved": {
            "type": "boolean"
          },
          "bodies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "position": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "velocity": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "size": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "resting": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "position",
                "velocity",
                "size",
                "resting"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 8
          },
          "water": {
            "type": "object",
            "properties": {
              "total_volume": {
                "type": "number",
                "minimum": 0
              },
              "reservoirs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "enum": [
                        "source",
                        "basin",
                        "goal"
                      ]
                    },
                    "volume": {
                      "type": "number",
                      "minimum": 0
                    },
                    "capacity": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "base_y": {
                      "type": "number"
                    },
                    "level": {
                      "type": "number",
                      "minimum": 0
                    },
                    "position": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "size": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    }
                  },
                  "required": [
                    "id",
                    "volume",
                    "capacity",
                    "base_y",
                    "level",
                    "position",
                    "size"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 3
              }
            },
            "required": [
              "total_volume",
              "reservoirs"
            ],
            "additionalProperties": false
          },
          "valves": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "enum": [
                    "feed",
                    "gate"
                  ]
                },
                "open": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "open"
              ],
              "additionalProperties": false
            },
            "maxItems": 2
          }
        },
        "required": [
          "step",
          "time",
          "contacts",
          "max_penetration",
          "puzzle_solved",
          "bodies",
          "water",
          "valves"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "project",
    "seed",
    "mode",
    "spec",
    "summary",
    "geometry",
    "frames"
  ],
  "additionalProperties": false
}
