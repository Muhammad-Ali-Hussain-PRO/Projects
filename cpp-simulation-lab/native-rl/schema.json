{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://windrunner.local/schema/v1",
  "title": "WindRunner trajectory / train / evaluate result",
  "type": "object",
  "required": ["project", "seed", "mode", "summary", "frames"],
  "properties": {
    "project": {"const": "windrunner"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "mode": {"enum": ["trained", "random", "zero", "train", "evaluate"]},
    "summary": {"type": "object"},
    "environment": {
      "type": "object",
      "required": ["dt", "goal", "radius", "horizon", "phases"],
      "properties": {
        "dt": {"const": 0.08}, "goal": {"const": 64}, "radius": {"const": 0.22}, "horizon": {"const": 400},
        "phases": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}
      }
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "t", "x", "y", "vx", "vy", "center", "halfWidth", "windX", "windY", "action", "reward", "return", "done", "terminal"],
        "properties": {
          "step": {"type": "integer", "minimum": 0},
          "t": {"type": "number"}, "x": {"type": "number"}, "y": {"type": "number"},
          "vx": {"type": "number"}, "vy": {"type": "number"},
          "center": {"type": "number"}, "halfWidth": {"type": "number"},
          "windX": {"type": "number"}, "windY": {"type": "number"},
          "action": {"type": "array", "items": {"type": "number", "minimum": -1, "maximum": 1}, "minItems": 2, "maxItems": 2},
          "reward": {"type": "number"}, "return": {"type": "number"},
          "done": {"type": "boolean"},
          "terminal": {"enum": ["running", "collision", "goal", "timeout"]}
        }
      }
    },
    "episodes": {"type": "array"}
  }
}
